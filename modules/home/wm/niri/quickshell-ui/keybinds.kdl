// QuickShell-specific keybinds
Mod+Space { spawn "qs-toggle-launcher"; }
Mod+V { spawn "qs-toggle-launcher" "!"; }
Mod+Slash { spawn "qs-toggle-launcher" "/"; }
Mod+I { spawn "qs-ipc" "call" "idleInhibitor" "toggle"; }
Mod+N { spawn "qs-ipc" "call" "notifications" "toggleDnd"; }
Mod+B { spawn "qs-ipc" "call" "bluetooth" "toggle"; }
Mod+Shift+V { spawn "qs-ipc" "call" "vpn" "toggleOpenvpn"; }
Mod+Shift+Q { spawn "systemctl" "--user" "restart" "quickshell"; }
